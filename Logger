            end
        })
        if isLoaded then 
            table.insert(LoadLogElements, btn)
            table.insert(LoadedLogsRef, {Code = code, Btn = btn, OriginalText = text, Ticked = false}) 
        else
            table.insert(CreateLogElements, btn)
        end
    end
end)

local function safeAddLog(text, code, isLoaded)
    if not isLoaded and not IsRecording then return end
    table.insert(LogQueue, {text, code, isLoaded})
end

parseScript = function(content, isLocked)
    CurrentLoadedContent = content
    if LoadedExecSection then pcall(function() LoadedExecSection:Destroy() end); LoadedExecSection = nil end
    for _, el in pairs(LoadLogElements) do pcall(function() el:Destroy() end) end
    LoadLogElements = {}; LoadedLogsRef = {}
    LoadedExecSection = LoadedTab:CreateSection("Execution Steps")
    
    for line in content:gmatch("[^\r\n]+") do
        if not line:find("loadstring") and not line:find("StartAutomation") and line:match("%S") then
            local prefix = getEmojiPrefix(line)
            local detail = line:match('"(.-)"') or line:match('%((%d+)%)') or ""
            if line:find('QueuePlace') then detail = line:match('QueuePlace%("(.-)"') or "" end
            safeAddLog(detail ~= "" and (prefix .. " " .. detail) or prefix, line, true)
        end
    end
end


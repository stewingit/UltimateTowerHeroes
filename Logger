local StatParagraphs = {}

local function refreshStatsUI()
    local troops = TroopFolder:GetChildren()
    local currentUnits = {}
    local sTime = Workspace:GetServerTimeNow()

    for i, unit in ipairs(troops) do
        currentUnits[unit] = true
        local stats = unit:FindFirstChild("Stats")
        if stats then
            local unitModule = toStr(stats:FindFirstChild("Module") or unit)
            local level = stats:FindFirstChild("Level") and stats.Level.Value or 1
            local data = findUnitData(unitModule)
            
            local status = "MAX"
            local cooldownText = ""

            if data then
                local stg = data.Stages or data.Levels or data.Upgrades
                local cur, nxt = stg[level], stg[level + 1]

                if cur and cur.SpecialAbility then
                    local sa = cur.SpecialAbility
                    local cost = getFinalCost(sa.Cost or sa.Price, stats, true)
                    status = ("%s [%s]"):format(sa.Title or "Ability", cost or "Active")
                    
                    local aTick = stats:FindFirstChild("AbilityTick")
                    if aTick then
                        local cd = sa.Cooldown or sa.CD or sa.Duration or 0
                        local remaining = (aTick.Value + cd) - sTime
                        if remaining > 0 then
                            cooldownText = ("\n   > ⏳ (%.1fs / %ds)"):format(remaining, cd)
                        else
                            cooldownText = ("\n   > ✅ (READY / %ds)"):format(cd)
                        end
                    end
                elseif nxt then
                    status = ("Upgrade [%s]"):format(getFinalCost(nxt.Cost or nxt.Price, stats, false) or "???")
                end
            end

            local titleText = ("[%d] %s (Lvl %s)"):format(i, unitModule, tostring(level))
            local contentText = ("Status: %s%s\nTarget: %s"):format(
                status, cooldownText, toStr(stats:FindFirstChild("TargetType") or "N/A")
            )

            if StatParagraphs[unit] then
                pcall(function() StatParagraphs[unit]:Set({Title = titleText, Content = contentText}) end)
            else
                pcall(function() 
                    StatParagraphs[unit] = StatsTab:CreateParagraph({Title = titleText, Content = contentText}) 
                end)
            end
        end
    end

    -- Delete UI paragraphs for sold/removed units
    for unit, paragraph in pairs(StatParagraphs) do
        if not currentUnits[unit] then
            pcall(function() paragraph:Destroy() end)
            StatParagraphs[unit] = nil
        end
    end
end

